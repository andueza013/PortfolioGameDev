---
// src/layouts/Layout.astro
// Shared wrapper: <head>, sticky nav, footer.
// Usage:
//   <Layout title="..." description="...">
//     ... page content ...
//   </Layout>

import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio of Fernando Fernández Andueza — Gameplay & AI Programmer working in Unreal Engine 5 (C++), Unity (C#), and a custom C++ engine ported to Nintendo Switch (tested on an emulator).',
} = Astro.props;

const base = import.meta.env.BASE_URL;
// Open Graph requires absolute URLs — `site` is set in astro.config.mjs.
const ogImage = new URL(`${base}/profile.jpeg`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Fernando Fernández Andueza" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />

    <!-- Open Graph (LinkedIn / Twitter previews).
         The image is the 800×800 portrait, so the card type is `summary`, not
         `summary_large_image` — the latter expects roughly 1200×630 and would
         crop a square portrait badly. Swap both if a proper 1200×630 card is
         ever made. -->
    <meta property="og:title"        content={title} />
    <meta property="og:description"  content={description} />
    <meta property="og:type"         content="website" />
    <meta property="og:url"          content={canonical} />
    <meta property="og:site_name"    content="Fernando Fernández Andueza" />
    <meta property="og:locale"       content="en_GB" />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt"    content="Portrait of Fernando Fernández Andueza" />
    <meta name="twitter:card"        content="summary" />

    <title>{title}</title>

    <!-- JetBrains Mono — used for eyebrow, nav logo, tags -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <p class="footer-left">
            <strong>Fernando Fernández Andueza</strong> · Valencia, Spain<br />
            Open to gameplay programmer &amp; AI programmer roles
          </p>
          <ul class="footer-links">
            <li><a href="https://linkedin.com/in/fernando-fernandez-andueza" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="https://anduezadev.itch.io" target="_blank" rel="noopener">itch.io</a></li>
            <li><a href="mailto:anduezadev@gmail.com">Email</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
}

const { title, description, tags, link } = Astro.props;
---

<a href={link} class="group block border border-slate-700 hover:border-blue-500 p-6 rounded-xl bg-slate-800 transition-all duration-300 hover:-translate-y-1">
  <h3 class="text-xl font-bold mb-2 group-hover:text-blue-400">{title}</h3>
  <p class="text-slate-400 mb-4 text-sm">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="bg-blue-900/50 text-blue-200 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-semibold">
        {tag}
      </span>
    ))}
  </div>
</a>
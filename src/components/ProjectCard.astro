---
// src/components/ProjectCard.astro
// One entry of the home page's "Other projects" grid: image, title, one grey
// line (kind of project, then tech) and the description. No card box, no pills.
// Props:
//   title       — project name; links to `link` when there is one
//   description — short summary
//   tech        — string[], joined into the grey line
//   link        — optional external URL (itch.io, etc.)
//   img         — optional thumbnail filename (looks in /public/project-images/)
//   kind        — optional: "shipped" | "gamejam" | "personal" | "academic"

interface Props {
  title:       string;
  description: string;
  tech:        string[];
  link?:       string;
  img?:        string;
  kind?:       'shipped' | 'gamejam' | 'personal' | 'academic';
}

const { title, description, tech, link, img, kind } = Astro.props;

const kindLabels: Record<string, string> = {
  shipped:  'Steam',
  gamejam:  'Game jam',
  personal: 'Personal',
  academic: 'Academic',
};

const meta = [kind && kindLabels[kind], tech.join(', ')].filter(Boolean).join('. ');
---

<article class="proj">
  {img && (
    <img
      src={`${import.meta.env.BASE_URL}/project-images/${img}`}
      alt={title}
      loading="lazy"
    />
  )}
  <h3>
    {link ? <a href={link} target="_blank" rel="noopener" class="link">{title}</a> : title}
  </h3>
  <p class="home-meta">{meta}</p>
  <p>{description}</p>
</article>

---
// src/components/ProjectCard.astro
// Generic project card for the jams / prototypes grid.
// Props:
//   title       — project name
//   description — 2-3 sentence technical summary
//   tags        — string[], rendered as mono pills
//   link        — optional external URL (itch.io, GitHub, etc.)
//   linkLabel   — button text (default: "View project")
//   img         — optional thumbnail filename (looks in /public/project-images/)
//   video       — optional embed URL (YouTube/Drive), takes priority over img
//   badge       — optional status string: "shipped" | "gamejam" | "personal" | "academic"

interface Props {
  title:       string;
  description: string;
  tags:        string[];
  link?:       string;
  linkLabel?:  string;
  img?:        string;
  video?:      string;
  badge?:      'shipped' | 'gamejam' | 'personal' | 'academic';
}

const {
  title,
  description,
  tags,
  link,
  linkLabel = 'View project',
  img,
  video,
  badge,
} = Astro.props;

const badgeLabels: Record<string, string> = {
  shipped:  'Steam',
  gamejam:  'Game Jam',
  personal: 'Personal',
  academic: 'Academic',
};
---

<article class="card">
  {video ? (
    <div class="video-wrapper card-media">
      <iframe
        src={video}
        title={title}
        allow="accelerated-encrypted-media; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  ) : img && (
    <img
      src={`${import.meta.env.BASE_URL}/project-images/${img}`}
      alt={title}
      class="thumbnail"
      loading="lazy"
    />
  )}

  <div class="card-head">
    <h3>{title}</h3>
    {badge && (
      <span class={`badge badge-${badge}`}>
        <span class="badge-dot"></span>
        {badgeLabels[badge]}
      </span>
    )}
  </div>

  <p>{description}</p>

  <div class="tag-container">
    {tags.map(tag => <span class="tag">{tag}</span>)}
  </div>

  {link && (
    <div class="card-links">
      <a href={link} target="_blank" rel="noopener" class="btn-secondary">
        {linkLabel} ↗
      </a>
    </div>
  )}
</article>
---
// src/components/ResumeEntry.astro
// One row of the home page's Experience / Education list: date, role, org.
// The data comes from src/data/cv.ts, so the CV page shows the same entries;
// the detail (notes and bullet points) lives only on /cv.

import type { Entry } from '../data/cv';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<div class="resume-row">
  <span class="resume-row-date">{entry.date}</span>
  <span class="resume-row-role">{entry.role}</span>
  <span class="resume-row-org">
    {entry.orgLink ? (
      <a href={entry.orgLink} target="_blank" rel="noopener">{entry.org}</a>
    ) : (
      entry.org
    )}
  </span>
</div>

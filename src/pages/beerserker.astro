---
// src/pages/beerserker.astro
// Technical breakdown of the enemy AI built for Beerserker: The Stolen Brew.
//
// SCOPE NOTE: Beerserker is a commercial project, so no source from the studio
// repository is reproduced here. Everything below describes architecture and
// decisions, illustrated with gameplay clips and an editor capture.
//
// MEDIA: archetype clips are muted, looping <video> (public/project-images/
// beerserker/videos/*.mp4) rather than <img>/GIF — Astro's image optimisation
// doesn't process animated GIFs, and a properly encoded MP4 is a fraction of
// the size. The StateTree graph stays a static <img> (PNG).
//
// LAYOUT: editorial long-form — running prose, alternating image/text rows and
// pull-quotes instead of a grid of tech cards. graphic-engine.astro uses the same layout.
// See src/styles/global.css, "Editorial detail page (beerserker)".

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Beerserker Enemy AI · Technical breakdown — Fernando Fernández Andueza"
  description="How I built the enemy AI for Beerserker: The Stolen Brew with StateTree in Unreal Engine 5, from the melee enemy to the tank mini-boss."
>
  <div class="container page-container">

    <!-- ── PAGE HEADER ──────────────────────────────────────────────────── -->
    <div class="page-header">
      <a href={import.meta.env.BASE_URL} class="back-link">← Back to portfolio</a>

      <div class="ed-header-panel">
        <img
          class="ed-header-capsule"
          src={`${import.meta.env.BASE_URL}/project-images/beerserker/Capsule.png`}
          alt="Beerserker: The Stolen Brew — Steam capsule artwork"
        />

        <div class="ed-header-text">
          <p class="ed-kicker">Enemy AI · Technical breakdown</p>

          <h1>Beerserker</h1>
          <p class="ed-lede">
           Beerserker is a modern, fast-paced arcade game with a comical twist. Blinded by the taste of the legendary dwarven ale, Ragna sets out to take it back from the gods. Can you fight your way through a crowded dwarven brewery, or will you be crushed by their ranks?
          </p>

          <div class="card-meta" style="margin-top: 1.5rem;">
            <span class="badge badge-shipped"><span class="badge-dot"></span>Early Access on Steam</span>
            <span class="card-engine">Unreal Engine 5 &nbsp;·&nbsp; C++ &nbsp;·&nbsp; StateTree</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── THE BRIEF ─────────────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2 class="ed-kicker">The brief</h2>

      <span class="ed-label">The production</span>
      <p class="ed-prose">
        Beerserker: The Stolen Brew is my final-year project at ESAT, with about 20 people
        across programming, art, design, music and production. It came out on Steam in Early
        Access on 7 July 2026 and is free.
      </p>

      <span class="ed-label">What I did</span>
      <p class="ed-prose">
        I worked mostly on the AI. I implemented the four enemy archetypes with <strong>StateTree</strong>,
        in C++ and Blueprints, with custom tasks and conditions, and
        used <strong>EQS</strong> to query the environment. I also built an object pool
        as a plugin and the enemy spawners, and I was in charge of configuring and uploading the builds to Steam. We used Perforce for
        version control.
      </p>
      <p class="ed-prose">
        Other Unreal tools I used: actor components, plugins, Animation Montages, Animation
        Notifies, Two Bone IK and GameInstance Subsystems.
      </p>

      <figure class="tech-figure">
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube.com/embed/2bR2OxafTjQ?si=HfbHE73XUxKJRXTU"
            title="Beerserker: The Stolen Brew — Trailer"
            allow="encrypted-media; picture-in-picture"
            loading="lazy"
            allowfullscreen></iframe>
        </div>
        <figcaption>Beerserker: The Stolen Brew — trailer.</figcaption>
      </figure>
    </div>

    <!-- ── THE FOUR ARCHETYPES ───────────────────────────────────────────── -->
    <div class="tech-section">
      <h2 class="ed-kicker">The four archetypes</h2>

      <div class="ed-row">
        <div class="ed-num">01</div>
        <div class="ed-media">
          <figure class="tech-figure">
            <video
              autoplay
              loop
              muted
              playsinline
              aria-label="Melee enemy moving towards the player and hitting them"
            >
              <source src={`${import.meta.env.BASE_URL}/project-images/beerserker/videos/Melee.mp4`} type="video/mp4" />
            </video>
          </figure>
        </div>
        <div class="ed-body">
          <h3>Melee</h3>
          <div class="ed-rule"></div>
          <p>
            It moves towards the player until the player is in range, then hits them.
          </p>
        </div>
      </div>

      <div class="ed-row ed-row--rev">
        <div class="ed-num">02</div>
        <div class="ed-media">
          <figure class="tech-figure">
            <video
              autoplay
              loop
              muted
              playsinline
              aria-label="Ranged enemy retreating to a safe spot and shooting at the player"
            >
              <source src={`${import.meta.env.BASE_URL}/project-images/beerserker/videos/Ranged.mp4`} type="video/mp4" />
            </video>
          </figure>
        </div>
        <div class="ed-body">
          <h3>Ranged</h3>
          <div class="ed-rule ed-rule--purple"></div>
          <p>
            It gets in range and shoots. When the player is too close, it looks for a safe
            spot to retreat to and shoot from.
          </p>
        </div>
      </div>

      <div class="ed-row">
        <div class="ed-num">03</div>
        <div class="ed-media">
          <figure class="tech-figure">
            <video
              autoplay
              loop
              muted
              playsinline
              aria-label="Explosive enemy blinking faster as its detonation timer runs down"
            >
              <source src={`${import.meta.env.BASE_URL}/project-images/beerserker/videos/Bomb.mp4`} type="video/mp4" />
            </video>
          </figure>
        </div>
        <div class="ed-body">
          <h3>Explosive</h3>
          <div class="ed-rule ed-rule--amber"></div>
          <p>
            It blinks red, faster and faster as its timer runs down, so the player can tell at a
            glance how much time is left. If it never reaches the player, it explodes when the
            timer runs out; if it does, it explodes after a short wind-up animation; and if it is
            killed, it explodes straight away. The way to deal with it is to kill it from a
            distance before it gets close.
          </p>
        </div>
      </div>

      <div class="ed-row ed-row--rev">
        <div class="ed-num">04</div>
        <div class="ed-media">
          <figure class="tech-figure">
            <video
              autoplay
              loop
              muted
              playsinline
              aria-label="Tank mini-boss switching between its four attacks"
            >
              <source src={`${import.meta.env.BASE_URL}/project-images/beerserker/videos/Tank.mp4`} type="video/mp4" />
            </video>
          </figure>
        </div>
        <div class="ed-body">
          <h3>Tank mini-boss</h3>
          <div class="ed-rule ed-rule--green"></div>
          <p>
            It has four attacks. At range, it throws honey or throws a dwarf; up close, it does
            a sweep that leaves honey on the ground, or an area attack. Each ranged attack has its own cooldown, and it only throws
            honey when the player is within a set distance range. The two melee attacks share a cooldown and are
            picked by weight (see below). To throw a dwarf, it
            calls one over, waits for it to arrive, checks it's still alive, grabs it and throws
            it. If there's no dwarf to throw, it uses a different attack.
          </p>
        </div>
      </div>
    </div>

    <!-- ── WHY STATETREE, NOT BEHAVIOR TREE ───────────────────────────────── -->
    <div class="tech-section">
      <h2 class="ed-kicker">Why StateTree, not Behavior Tree</h2>

      <p class="ed-lede">
        We chose <strong>StateTree</strong> because Epic is adopting it as the standard, and
        because we were forcing Behavior Trees to work like state machines, when StateTree
        already is one.
      </p>

      <figure class="tech-figure">
        <img
          src={`${import.meta.env.BASE_URL}/project-images/beerserker/statetree-graph.png`}
          alt="StateTree graph of the tank mini-boss"
          loading="lazy"
        />
        <figcaption>The tank's StateTree graph.</figcaption>
      </figure>
    </div>

    <!-- ── DESIGN DECISIONS ───────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2 class="ed-kicker">Design decisions</h2>

      <div class="ed-list">
        <div class="ed-item">
          <span class="ed-item-index">01</span>
          <div class="ed-item-body">
            <h3>Why an object pool</h3>
            <p>
              The game keeps many enemies on screen at all times, plus particles, decals and
              projectiles, so I wrote an object pool, as a plugin that can be reused in
              other projects. When an enemy returns to the pool, its StateTree stops on
              the next frame, and when it is reused it starts again from the beginning.
            </p>
          </div>
        </div>

        <div class="ed-item">
          <span class="ed-item-index">02</span>
          <div class="ed-item-body">
            <h3>Where the ranged enemy retreats to</h3>
            <p>
              The enemy retreats to a safe spot, picked with an <strong>EQS</strong> query based
              on distance to the player and line of sight.
            </p>
          </div>
        </div>

        <div class="ed-item">
          <span class="ed-item-index">03</span>
          <div class="ed-item-body">
            <h3>Which attack the tank picks</h3>
            <p>
              Each of the tank's melee attacks starts with a weight of 1, and every time it uses
              one, that attack's weight goes up. The less an attack has been used, the more likely
              it is to come up, so the tank doesn't keep repeating the same one.
            </p>
          </div>
        </div>

        <div class="ed-item">
          <span class="ed-item-index">04</span>
          <div class="ed-item-body">
            <h3>Which dwarf the tank throws</h3>
            <p>
              When the tank calls a dwarf, it looks for the dwarves within a configurable radius,
              checks with a line trace that it can see them, and picks the closest one. The
              selection is triggered by an AnimNotifyState at the point in the animation where
              the tank calls the dwarf.
            </p>
          </div>
        </div>

        <div class="ed-item">
          <span class="ed-item-index">05</span>
          <div class="ed-item-body">
            <h3>Stun through StateTree events</h3>
            <p>
              When the player hits an enemy with an attack that stuns, the enemy receives
              the <code>StateTree.Stun</code> event, which takes it into the stun state. When the
              animation ends, an Animation Notify sends <code>StateTree.StunFinish</code> to leave it.
              The tank can't be stunned.
            </p>
          </div>
        </div>

        <div class="ed-item">
          <span class="ed-item-index">06</span>
          <div class="ed-item-body">
            <h3>Exposed attributes and varied melee attacks</h3>
            <p>
              The enemies' attributes are exposed in the editor for tuning: attack range,
              cooldowns, detection radius and honey distances. Each attack's cooldown is set by
              GameplayTag and checked by a custom StateTree condition. In the melee enemies,
              attacks are a list of animations: adding a new one is enough for the enemy to use
              it, so combat feels less repetitive.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ── LINKS ─────────────────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2 class="ed-kicker">The game</h2>
      <div class="card-links">
        <a
          href="https://store.steampowered.com/app/4522440/"
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path
              d="M12.695 0C8.772 0 5.314 2.578 4.05 6.148l6.624 2.777c.666-.57 1.55-.923 2.526-.923 2.137 0 3.872 1.735 3.872 3.872 0 .976-.353 1.86-.923 2.527l2.777 6.624C21.422 18.686 24 15.228 24 11.305 24 5.06 18.94 0 12.695 0zM5.997 15.17c-.426.668-.667 1.458-.667 2.304 0 2.395 1.942 4.336 4.337 4.336.846 0 1.636-.24 2.304-.666l-5.974-5.974z"
            ></path>
          </svg>
          Play on Steam
        </a>
      </div>
    </div>

    <!-- ── PAGE NAV ─────────────────────────────────────────────────────── -->
    <nav class="page-nav" aria-label="More pages">
      <a href={import.meta.env.BASE_URL} class="back-link">← Back to portfolio</a>
      <a href={`${import.meta.env.BASE_URL}/graphic-engine`} class="back-link">XEMA technical breakdown →</a>
    </nav>

  </div><!-- /.container -->

</Layout>

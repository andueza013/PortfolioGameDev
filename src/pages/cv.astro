---
// src/pages/cv.astro
// Print-optimised CV. On screen it matches the rest of the site; when printed
// (or saved as PDF) the nav, footer and toolbar are hidden, colours flatten to
// black on white, the contact URLs are spelled out, and the whole CV fits on one
// A4 page.
//
// All content comes from src/data/cv.ts — the home page renders the same data.

import Layout from '../layouts/Layout.astro';
import {
  profile,
  summary,
  experience,
  education,
  cvProjects,
  skillRows,
} from '../data/cv';

const lastUpdated = new Date().toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});

// The contact line prints its URLs as text, so on paper they can still be typed in.
const printUrl = (href: string) => href.replace(/^https?:\/\//, '');
---

<Layout
  title={`CV | ${profile.name}`}
  description={`Curriculum vitae of ${profile.name}, Gameplay and AI Programmer (Unreal Engine 5, Unity, custom C++ engine).`}
>
  <div class="container cv-container">
    <div class="cv-toolbar">
      <a href={import.meta.env.BASE_URL} class="back-link">Back to portfolio</a>
      <div class="cv-toolbar-actions">
        {/* A real file, because application forms and ATS ask you to upload one
            rather than to print a page. Regenerate it when this CV changes —
            see the README. */}
        <a
          href={`${import.meta.env.BASE_URL}/cv-fernando-fernandez-andueza.pdf`}
          class="btn-hero-primary"
          download
        >
          Download PDF
        </a>
      </div>
    </div>

    <article class="cv-sheet">
      <header class="cv-head">
        <h1>{profile.name}</h1>
        <p class="cv-role">{profile.role}</p>
        {/* The links are spaced by the flex gap, not by separator characters.
            The portfolio URL leads: on paper it is the way in. */}
        <p class="cv-contact cv-contact-links">
          <a href={profile.portfolio}>{printUrl(profile.portfolio)}</a>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.linkedin}>{printUrl(profile.linkedin)}</a>
          <a href={profile.itch}>{printUrl(profile.itch)}</a>
        </p>
        <p class="cv-contact">
          {profile.location}. EU citizen, open to relocation within Spain and to remote
          work. Spanish (native).
        </p>
      </header>

      <section class="cv-block">
        <h2>Profile</h2>
        <p class="cv-summary">{summary}</p>
      </section>

      <section class="cv-block">
        <h2>Technical skills</h2>
        <dl class="cv-skills">
          {skillRows.map(([label, list]) => (
            <>
              <dt>{label}</dt>
              <dd>{list}</dd>
            </>
          ))}
        </dl>
      </section>

      <section class="cv-block">
        <h2>Experience</h2>
        {experience.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry-head">
              <h3>
                {e.role},{' '}
                <span class="cv-org">
                  {e.orgLink ? <a href={e.orgLink}>{e.org}</a> : e.org}
                  {e.orgNote && e.orgNote.length <= 30 && <span class="cv-org-note"> ({e.orgNote})</span>}
                </span>
              </h3>
              <span class="cv-date">{e.date}</span>
            </div>
            {/* A short note (a studio name) fits beside the title; a long one gets its own line */}
            {e.orgNote && e.orgNote.length > 30 && <p class="cv-note">{e.orgNote}</p>}
            <ul class="cv-points">{e.points.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="cv-block">
        <h2>Selected projects</h2>
        {cvProjects.map((pr) => (
          <div class="cv-entry">
            <div class="cv-entry-head">
              <h3>{pr.link ? <a href={pr.link}>{pr.name}</a> : pr.name}</h3>
              <span class="cv-date cv-meta">{pr.meta}</span>
            </div>
            <ul class="cv-points">{pr.points.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="cv-block">
        <h2>Education &amp; certifications</h2>
        {education.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry-head">
              <h3>
                {e.role},{' '}
                <span class="cv-org">
                  {e.org}
                  {e.orgNote && <span class="cv-org-note">, {e.orgNote}</span>}
                </span>
              </h3>
              <span class="cv-date">{e.date}</span>
            </div>
            {e.points.map((pt) => <p>{pt}</p>)}
          </div>
        ))}
      </section>

      <p class="cv-updated">Last updated: {lastUpdated}</p>
    </article>
  </div>
</Layout>

<style>
  .cv-container {
    max-width: 900px;
    padding-bottom: 4rem;
  }

  .cv-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 2.5rem 0 1.5rem;
  }

  .cv-toolbar .back-link { margin-bottom: 0; }

  .cv-toolbar-actions {
    display: flex;
    align-items: center;
    gap: .625rem;
    flex-wrap: wrap;
  }

  .cv-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cv-head h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.2;
  }

  .cv-role {
    font-size: 15px;
    color: var(--text-3);
    margin: .25rem 0 .75rem;
  }

  .cv-contact {
    font-size: 12.5px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .cv-contact-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25em;
  }

  .cv-contact a {
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
  }

  .cv-contact a:hover { color: var(--accent); }

  .cv-block { margin-bottom: 1.75rem; padding: 0; }
  .cv-block:last-child { margin-bottom: 0; }

  .cv-block h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: .875rem;
  }

  .cv-summary {
    font-size: 13.5px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .cv-summary strong { color: var(--text); font-weight: 500; }

  .cv-entry { margin-bottom: 1.125rem; }
  .cv-entry:last-child { margin-bottom: 0; }

  .cv-entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cv-entry h3 {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .cv-entry h3 a { border-bottom: 1px solid var(--border); }
  .cv-entry h3 a:hover { color: var(--accent); }

  .cv-org { color: var(--text-2); font-weight: 400; }
  .cv-org-note { color: var(--text-3); }

  .cv-date {
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    white-space: nowrap;
  }

  /* Tech list, not a date: tabular figures spread out "4.5" and the commas */
  .cv-meta { font-variant-numeric: normal; }

  .cv-entry p,
  .cv-points li {
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.6;
  }

  .cv-entry p { margin-top: .3rem; }

  /* Studio / publisher context, on its own line so the date stays beside the title */
  .cv-entry p.cv-note {
    font-size: 12px;
    color: var(--text-3);
    margin-top: .1rem;
  }

  .cv-points {
    margin: .3rem 0 0;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .cv-points li + li { margin-top: .15rem; }

  .cv-skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: .4rem 1.25rem;
  }

  .cv-skills dt { font-size: 12.5px; font-weight: 500; color: var(--text); }
  .cv-skills dd { font-size: 12.5px; color: var(--text-2); line-height: 1.55; }

  .cv-updated {
    margin-top: 2rem;
    font-size: 12px;
    color: var(--text-3);
  }

  @media (max-width: 640px) {
    /* Short titles kept the date beside them and long ones wrapped it: always below on phones */
    .cv-entry-head { flex-direction: column; gap: .1rem; }
    .cv-skills { grid-template-columns: 1fr; gap: .1rem 0; }
    .cv-skills dd { margin-bottom: .5rem; }
  }
</style>

<style is:global>
  @media print {
    @page { size: A4; margin: 8mm 12mm; }

    /* Only the CV sheet survives */
    .site-nav,
    .site-footer,
    .cv-toolbar,
    .skip-link { display: none !important; }

    html, body { background: #fff !important; color: #000 !important; }
    /* The system face is more compact than the web font: with it, the CV fits
       on one A4 page */
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif !important; }
    .container, .cv-container { max-width: none !important; padding: 0 !important; }

    .cv-sheet {
      background: none !important;
      border: 0 !important;
      border-radius: 0 !important;
      padding: 0 !important;
    }

    .cv-head { border-bottom: 1px solid #999 !important; }
    .cv-head h1 { font-size: 19pt; }
    .cv-role { color: #000 !important; }

    .cv-contact,
    .cv-contact a,
    .cv-summary,
    .cv-entry p,
    .cv-points li,
    .cv-skills dd,
    .cv-org { color: #222 !important; }

    .cv-entry p.cv-note { color: #444 !important; }

    .cv-contact a { border-bottom: 0 !important; }
    .cv-entry h3 a { border-bottom: 0 !important; }
    .cv-org-note { color: #444 !important; }

    .cv-block h2 {
      color: #000 !important;
      border-bottom: 1px solid #ddd;
      padding-bottom: 2px;
      break-after: avoid;
      page-break-after: avoid;
    }

    .cv-entry h3,
    .cv-skills dt,
    .cv-summary strong { color: #000 !important; }

    .cv-date { color: #444 !important; }

    /* Entry links aren't spelled out on paper: the portfolio URL in the header
       leads to all of them, and a printed Steam URL pushed the dates onto a line
       of their own. */

    .cv-summary,
    .cv-entry p,
    .cv-points li { orphans: 3; widows: 3; line-height: 1.35 !important; }
    .cv-skills dd { line-height: 1.4 !important; }

    /* Long entries may flow onto the next page — keeping them whole left a
       third of page 1 empty. The heading still never gets stranded. */
    .cv-head { break-inside: avoid; page-break-inside: avoid; }
    .cv-entry-head { break-after: avoid; page-break-after: avoid; }

    .cv-updated { color: #666 !important; margin-top: 1rem !important; }

    /* Tighter vertical rhythm on paper so the CV fits on one page */
    .cv-head { padding-bottom: .6rem !important; margin-bottom: .8rem !important; }
    .cv-role { margin: .1rem 0 .35rem !important; }
    .cv-block { margin-bottom: .65rem !important; }
    .cv-block h2 { margin-bottom: .3rem !important; }
    .cv-entry { margin-bottom: .4rem !important; }
    .cv-points { margin-top: .15rem !important; }
    .cv-points li + li { margin-top: .05rem !important; }
    .cv-skills { gap: .15rem 1rem !important; }

    .cv-contact { font-size: 8.5pt !important; line-height: 1.5 !important; }
    .cv-summary,
    .cv-entry p,
    .cv-points li,
    .cv-skills dt,
    .cv-skills dd { font-size: 9pt !important; }
    .cv-entry p.cv-note { font-size: 8.5pt !important; }
    .cv-entry h3 { font-size: 10pt !important; }
    .cv-block h2 { font-size: 9pt !important; }
    .cv-date { font-size: 8.5pt !important; }
    .cv-points { padding-left: .9rem !important; }
    .cv-updated { display: none !important; }  }
</style>

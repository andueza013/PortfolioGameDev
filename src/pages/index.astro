---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import { experience, education, skillCategories, profile } from "../data/cv";

interface OtherProject {
  title: string;
  desc: string;
  img?: string;
  video?: string;
  link?: string;
  tags: string[];
  badge: "shipped" | "gamejam" | "personal" | "academic";
}

// Everything that isn't a featured project: coursework, jams and prototypes.
// The badge tells them apart, so they share one grid.
const otherProjects: OtherProject[] = [
  {
    title: "Abandoned Hospital",
    desc: "Academic project built to demonstrate AI Perception and EQS driving enemy and NPC behaviour in Unreal Engine. First implemented with behaviour trees, then rebuilt from scratch on StateTree.",
    img: "AH.webp",
    tags: [
      "Unreal Engine",
      "C++",
      "EQS",
      "StateTree",
      "Behaviour Trees",
      "AI Perception",
    ],
    badge: "academic",
  },
  {
    title: "P0-CH45",
    desc: "Built for Mini Jam 157: Electric. The player is a maintenance robot keeping a failing nuclear plant online: reactor components break down on a timer and power cables across the facility have to be traced and reconnected before the city loses power.",
    img: "pochas.png",
    link: "https://anduezadev.itch.io/p0-ch45",
    tags: ["Unity", "C#", "Game Jam"],
    badge: "gamejam",
  },
  {
    title: "Project Memento Vivere",
    desc: "University project: a 2.5D metroidvania in Unity with jump, attack and dash traversal. The player fights enemies driven by distinct movement patterns and attack routines to reach the end of the level.",
    img: "mementovivere.png",
    link: "https://anduezadev.itch.io/project-memento-vivere",
    tags: ["Unity", "C#", "Metroidvania"],
    badge: "academic",
  },
  {
    title: "Xperimental Exploration of the Marine Abyss",
    desc: "Game jam survival game. The player pilots an exploration submarine down to the ruins of a lost civilisation at abyssal depth, recovering as many valuable minerals as possible and surfacing with them before running out of resources.",
    img: "xema1.png",
    link: "https://anduezadev.itch.io/xperimental-exploration-of-the-marine-abyss",
    tags: ["Unity", "C#", "Survival"],
    badge: "gamejam",
  },
];
---

<Layout title="Fernando Fernández Andueza · Gameplay & AI Programmer">
  <div class="container">
    <!-- ── HERO ──────────────────────────────────────────────────────────── -->
    <header class="hero">
      <div class="hero-container">
        <div class="hero-content">
          <p class="hero-eyebrow">// gameplay &middot; ai &middot; c++</p>
          <h1 class="hero-name">Fernando Fernández Andueza</h1>
          <p class="hero-role">Gameplay &amp; AI Programmer</p>
          <p class="hero-pitch">
            I'm a gameplay &amp; AI programmer working in Unreal Engine 5 (C++ and Blueprints).
            I shipped <strong>Beerserker: The Stolen Brew</strong> on Steam — a 10-month
            production with a multidisciplinary team of 20+ at ESAT, published by Grumpy Games —
            where I built the AI for every enemy archetype in StateTree.
          </p>
          <p class="hero-pitch">
            Alongside it I wrote <strong>XEMA</strong>, a custom C++ engine, from scratch:
            OpenGL 4.5, deferred PBR rendering, an ECS core and a
            <strong>Nintendo Switch port</strong>, with a PlayStation 4 port currently in
            progress. Before games I spent 2+ years as a fullstack developer shipping ERP
            software in production.
          </p>

          <div class="hero-ctas">
            <a href="#projects" class="btn-hero-primary">View projects</a>
            <a href={`${import.meta.env.BASE_URL}/cv`} class="btn-hero-ghost">View CV</a>
            <a
              href={profile.github}
              target="_blank"
              rel="noopener"
              class="btn-hero-ghost"
            >
              GitHub ↗
            </a>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener"
              class="btn-hero-ghost"
            >
              LinkedIn ↗
            </a>
          </div>
        </div>

        <div class="hero-avatar-wrapper">
          <img
            src={`${import.meta.env.BASE_URL}/profile.jpeg`}
            alt="Portrait of Fernando Fernández Andueza"
            class="hero-avatar"
            width="800"
            height="800"
          />
        </div>
      </div>
    </header>

    <!-- ── FEATURED PROJECTS ─────────────────────────────────────────────── -->
    <section id="projects" aria-labelledby="projects-head">
      <h2 class="sec-head" id="projects-head">Featured projects</h2>

      <div class="featured-grid">
        <!-- Beerserker: The Stolen Brew -->
        <article class="card-featured">
          <div class="card-meta">
            <span class="badge badge-shipped">
              <span class="badge-dot"></span>Available on Steam
            </span>
            <span class="card-engine">Unreal Engine 5 &nbsp;·&nbsp; C++</span>
          </div>

          <h3>Beerserker: The Stolen Brew</h3>
          <p class="card-subtitle">
            Third-person action game &nbsp;·&nbsp; ESAT × Grumpy Games &nbsp;·&nbsp; Gameplay &amp; AI Programmer
          </p>

          <div class="video-wrapper card-media">
            <iframe
              src="https://www.youtube.com/embed/2bR2OxafTjQ?si=HfbHE73XUxKJRXTU"
              title="Beerserker: The Stolen Brew — Trailer"
              allow="accelerated-encrypted-media; picture-in-picture"
              loading="lazy"
              allowfullscreen></iframe>
          </div>

          <p>
            A fast-paced arcade action game with a comical twist, produced over 10
            months by a multidisciplinary team of 20+ programmers, artists, musicians
            and designers at ESAT, and published on Steam by Grumpy Games. I owned the
            enemy AI, built entirely in <strong>StateTree</strong>: a melee enemy, a
            ranged enemy, an explosive enemy, and a tank mini-boss with four distinct
            attack patterns.
          </p>

          <div class="card-links">
            <a
              href="https://store.steampowered.com/app/4522440/"
              target="_blank"
              rel="noopener"
              class="btn-primary"
            >
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12.695 0C8.772 0 5.314 2.578 4.05 6.148l6.624 2.777c.666-.57 1.55-.923 2.526-.923 2.137 0 3.872 1.735 3.872 3.872 0 .976-.353 1.86-.923 2.527l2.777 6.624C21.422 18.686 24 15.228 24 11.305 24 5.06 18.94 0 12.695 0zM5.997 15.17c-.426.668-.667 1.458-.667 2.304 0 2.395 1.942 4.336 4.337 4.336.846 0 1.636-.24 2.304-.666l-5.974-5.974z"
                ></path>
              </svg>
              Play on Steam
            </a>
          </div>
        </article>

        <!-- XEMA Engine -->
        <article class="card-featured">
          <div class="card-meta">
            <span class="badge badge-personal">
              <span class="badge-dot"></span>University project
            </span>
            <span class="card-engine"
              >C++ &nbsp;·&nbsp; OpenGL 4.5 &nbsp;·&nbsp; Nintendo Switch</span
            >
          </div>

          <h3>XEMA — Custom 3D Engine</h3>
          <p class="card-subtitle">
            Built from scratch &nbsp;·&nbsp; Cross-platform
          </p>

          <img
            src={`${import.meta.env.BASE_URL}/project-images/engine1.jpg`}
            alt="Scene rendered by the XEMA engine"
            class="thumbnail card-media"
            loading="lazy"
          />

          <p>
            XEMA engine is a graphics engine I developed solo over the course of
            10 months using OpenGL for both PC and Nintendo Switch (with a PS4
            port currently in progress). An ECS architecture was chosen to
            ensure the engine core is efficient and cache-friendly. It features
            deferred rendering with PBR capabilities. A job system has also been
            implemented, which the engine uses for asynchronous asset loading.
            It includes a Lua scripting system, PhysX integration and
            multithreaded Wave Function Collapse biome generation.
          </p>

          <div class="card-links">
            <a href={`${import.meta.env.BASE_URL}/graphic-engine`} class="btn-secondary"
              >Technical breakdown →</a
            >
          </div>
        </article>

        <!-- Roadtrip: The Engine of Madness -->
        <article class="card-featured">
          <div class="card-meta">
            <span class="badge badge-development">
              <span class="badge-dot"></span>In development · Steam page live
            </span>
            <span class="card-engine">Unity &nbsp;·&nbsp; C#</span>
          </div>

          <h3>Roadtrip: The Engine of Madness</h3>
          <p class="card-subtitle">
            Horror driving game &nbsp;·&nbsp; Oniric Tales &nbsp;·&nbsp;
            Gameplay Programmer
          </p>

          <div class="video-wrapper card-media">
            <iframe
              src="https://www.youtube.com/embed/e15C8ltjDOQ?si=vq4NW1F98MPu64Yu"
              title="Roadtrip: The Engine of Madness — Trailer"
              allow="accelerated-encrypted-media; picture-in-picture"
              loading="lazy"
              allowfullscreen></iframe>
          </div>

          <p>
            Design, architecture and development of core gameplay systems. Built a
            scalable component-based dialogue system, an AI perception system integrated
            into behaviour trees, and a radio communication system; contributed to the
            Behavior Graph, general gameplay mechanics, profiling and bug fixing.
          </p>

          <div class="card-links">
            <a
              href="https://store.steampowered.com/app/3776540/Roadtrip_El_Motor_de_la_Locura/"
              target="_blank"
              rel="noopener"
              class="btn-secondary"
            >
              View on Steam ↗
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- ── OTHER PROJECTS ────────────────────────────────────────────────── -->
    <section id="other-projects" aria-labelledby="other-projects-head">
      <h2 class="sec-head" id="other-projects-head">Other projects</h2>
      <div class="grid">
        {
          otherProjects.map((game) => (
            <ProjectCard
              title={game.title}
              description={game.desc}
              tags={game.tags}
              link={game.link}
              linkLabel="Play on itch.io"
              img={game.img}
              video={game.video}
              badge={game.badge}
            />
          ))
        }
      </div>
    </section>

    <!-- ── RESUME / BACKGROUND ───────────────────────────────────────────── -->
    <section id="resume" aria-labelledby="resume-head">
      <h2 class="sec-head" id="resume-head">Experience &amp; academic path</h2>

      <div class="resume-layout">
        <div class="resume-column">
          <h3 class="resume-section-title">Experience</h3>
          {experience.map((entry) => <ResumeEntry entry={entry} />)}
        </div>

        <div class="resume-column">
          <h3 class="resume-section-title">Academic path</h3>
          {education.map((entry) => <ResumeEntry entry={entry} />)}
        </div>
      </div>
    </section>

    <!-- ── SKILLS ────────────────────────────────────────────────────────── -->
    <section id="skills" aria-labelledby="skills-head">
      <h2 class="sec-head" id="skills-head">Technical skills</h2>
      <div class="skills-grid">
        {
          skillCategories.map((category) => (
            <div>
              <p class="skill-group-label">{category.label}</p>
              <div class="skill-list">
                {category.skills.map((skill) => (
                  <span class:list={["skill-item", { hi: skill.hi }]}>
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── CONTACT ───────────────────────────────────────────────────────── -->
    <section id="contact" aria-labelledby="contact-head">
      <h2 class="sec-head" id="contact-head">Get in touch</h2>

      <div class="contact-panel">
        <div class="contact-pitch">
          <h3>Open to gameplay &amp; AI programmer roles</h3>
          <p>
            I'm looking for a gameplay or AI programming position in Unreal Engine or
            Unity. If you have an opening — or just want the technical detail behind
            any of the projects above — write to me and I'll get back to you.
          </p>
          <ul class="contact-facts">
            {
              profile.facts.map(([label, value]) => (
                <li><span>{label}</span> {value}</li>
              ))
            }
          </ul>
        </div>

        <div class="contact-actions">
          <a href={`mailto:${profile.email}`} class="btn-hero-primary">{profile.email}</a>
          <a href={`${import.meta.env.BASE_URL}/cv`} class="btn-hero-ghost">View CV</a>
          <a href={profile.linkedin} target="_blank" rel="noopener" class="btn-hero-ghost">LinkedIn ↗</a>
          <a href={profile.github} target="_blank" rel="noopener" class="btn-hero-ghost">GitHub ↗</a>
          <a href={profile.itch} target="_blank" rel="noopener" class="btn-hero-ghost">itch.io ↗</a>
        </div>
      </div>
    </section>
  </div><!-- /.container -->
</Layout>

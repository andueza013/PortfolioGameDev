---
import '../styles/global.css';

const itchGames = [
  {
    title: "Project Memento Vivere",
    desc: "Atmospheric narrative-driven project focusing on custom event-triggering systems and state management.",
    img: "mementovivere.png", // Make sure to place your thumbnail in public/images/
    link: "https://anduezadev.itch.io/project-memento-vivere",
	tech:["Unity","C#"]
  },
  {
    title: "Bullet Hell",
    desc: "High-performance projectile system implementing object pooling and pattern-based movement math.",
    img: "bullethell.png",
    link: "https://anduezadev.itch.io/bullet-hell",
	tech:["Unity","C#"]
  },
  {
    title: "ColorSwitcher",
    desc: "Mechanic-driven prototype exploring input-to-state mapping and shader-based visual feedback.",
    img: "colorswitcher.png",
    link: "https://anduezadev.itch.io/colorswitcher",
	tech:["Unity","C#"]
  },
  {
    title: "P0-CH45",
    desc: "Logic-heavy puzzle implementation focusing on constrained movement systems and grid-based gameplay.",
    img: "pochas.png",
    link: "https://anduezadev.itch.io/p0-ch45",
	tech:["Unity","C#"]
  },
  {
    title: "SkateVillagerush",
    desc: "Physics-based movement prototype experimenting with character controller momentum and friction values.",
    img: "svr.png",
    link: "https://anduezadev.itch.io/skatevillagerush",
	tech:["Unity","C#"]
  },
  {
    title: "Marine Abyss Exploration",
    desc: "Environment interaction prototype featuring custom lighting parameters and ray-casting based exploration triggers.",
    img: "xema1.png",
    link: "https://anduezadev.itch.io/xperimental-exploration-of-the-marine-abyss",
	tech:["Unity","C#"]
  }
];
---
<html lang="en">
  <body>
    <div class="container">
      <header>
        <h1>Fernando Fernandez Andueza</h1>
        <p>Gameplay Programmer & Engine Developer</p>
      </header>

<section>
  <h2>Featured Projects</h2>
  <div class="grid">
    <!-- Beerserker -->
    <article class="card">
      <h3>Beerserker: The Stolen Brew</h3>
      <div class="video-wrapper">
        <iframe src="https://www.youtube.com/embed/2bR2OxafTjQ?rel=0&modestbranding=1&autohide=1" title="Trailer" allowfullscreen></iframe>
      </div>
      <p>Gameplay Programmer. Developed enemy AI using StateTree and EQS, and implemented efficient object pooling.</p>
      <div class="tag-container">
        <span class="tag">Unreal Engine</span>
        <span class="tag">C++</span>
        <span class="tag">AI Systems</span>
      </div>
<a href="https://store.steampowered.com/app/4522440/" target="_blank" class="btn-primary">
  <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
    <path d="M12.695 0C8.772 0 5.314 2.578 4.05 6.148l6.624 2.777c.666-.57 1.55-.923 2.526-.923 2.137 0 3.872 1.735 3.872 3.872 0 .976-.353 1.86-.923 2.527l2.777 6.624C21.422 18.686 24 15.228 24 11.305 24 5.06 18.94 0 12.695 0zM5.997 15.17c-.426.668-.667 1.458-.667 2.304 0 2.395 1.942 4.336 4.337 4.336.846 0 1.636-.24 2.304-.666l-5.974-5.974z"/>
  </svg>
  View on Steam
</a>
    </article>

    <!-- Motor Gráfico -->
    <article class="card">
	<img src="/project-images/engine1.jpg" alt="Xema engine" class="thumbnail" />
      <h3>XEMA: Custom 3D Engine</h3>
      <div class="placeholder-img"><span>Engine Architecture</span></div>
      <p>High-performance C++ engine built from scratch. Features Job System, ECS, and Nintendo Switch porting.</p>
      <div class="tag-container">
        <span class="tag">C++</span>
        <span class="tag">OpenGL 4.5</span>
        <span class="tag">Low-Level</span>
      </div>
      <a href="/graphic-engine" class="btn-secondary">Technical Details</a>
    </article>
  </div>
</section>

<section>
  <h2>Game Jams & Prototypes</h2>
  <div class="grid">
    {itchGames.map((game) => (
      <article class="card">
        <img src={`/project-images/${game.img}`} alt={game.title} class="thumbnail" />
        <h3>{game.title}</h3>
        <p>{game.desc}</p>
        <div class="tag-container">
          {game.tech.map(t => <span class="tag">{t}</span>)}
        </div>
<a href={game.link} target="_blank" class="btn-secondary">
  <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
    <path d="M12.333 0C6.053 0 .986 5.06.986 11.333c0 4.22 2.31 7.878 5.714 9.837l1.493-5.935c-1.02-.435-1.75-1.44-1.75-2.635 0-1.575 1.275-2.85 2.85-2.85s2.85 1.275 2.85 2.85c0 1.195-.73 2.2-1.75 2.635l1.493 5.935c3.404-1.96 5.714-5.617 5.714-9.837C23.68 5.06 18.613 0 12.333 0zM8.804 15.804a1.245 1.245 0 01-1.764 0a1.245 1.245 0 010-1.764a1.245 1.245 0 011.764 0c.488.487.488 1.277 0 1.764zm8.588 0a1.246 1.246 0 01-1.764 0a1.246 1.246 0 010-1.764a1.246 1.246 0 011.764 0a1.246 1.246 0 010 1.764z"/>
  </svg>
  View on Itch.io
</a>
      </article>
    ))}
  </div>
</section>

    
    </div>
  </body>
</html>
---
// src/pages/graphic-engine.astro
// Technical breakdown of the XEMA custom C++ engine.
// Every claim here comes from the author's own description of the engine —
// don't add technical detail that he hasn't stated.

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="XEMA Engine · Technical Breakdown — Fernando Fernández Andueza"
  description="XEMA — a C++ and OpenGL engine with ECS, deferred PBR rendering, Lua scripting and PhysX, for PC and Nintendo Switch (tested on an emulator)."
>
  <div class="container page-container">

    <!-- ── PAGE HEADER ──────────────────────────────────────────────────── -->
    <div class="page-header">
      <a href={import.meta.env.BASE_URL} class="back-link">← Back to portfolio</a>

      <div class="card-meta">
        <span class="badge badge-personal"><span class="badge-dot"></span>University project</span>
        <span class="card-engine">C++ &nbsp;·&nbsp; OpenGL &nbsp;·&nbsp; PC &nbsp;·&nbsp; Nintendo Switch (emulator)</span>
      </div>

      <h1>XEMA — Custom 3D Engine</h1>
      <p class="page-intro">
        XEMA is a graphics engine I built entirely myself in C++ and OpenGL, for PC and
        Nintendo Switch. On Switch I have only tested it on an emulator. I am currently
        working on a PS4 port using its own graphics API.
      </p>
    </div>

    <!-- ── CORE SYSTEMS ──────────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2>Core systems</h2>
      <div class="tech-grid">

        <div class="tech-card">
          <h3>Architecture</h3>
          <ul>
            <li>ECS (Entity Component System) architecture.</li>
            <li>
              JobSystem to speed up work such as asynchronous mesh loading.
            </li>
          </ul>
        </div>

        <div class="tech-card">
          <h3>Libraries and tools</h3>
          <ul>
            <li>GLFW for input and window management.</li>
            <li>
              ImGui for visual markers of entities, components and performance.
            </li>
            <li>PhysX integration for physics.</li>
            <li>Lua scripting.</li>
          </ul>
          <figure class="tech-figure tech-figure--inset">
            <img
              src={`${import.meta.env.BASE_URL}/project-images/xema/imgui-stats.png`}
              alt="ImGui stats panel showing FPS, frame time and the time spent in each engine section"
              width="290"
              height="281"
              loading="lazy"
            />
            <figcaption>ImGui performance panel: frame time and time per engine section.</figcaption>
          </figure>
        </div>

        <div class="tech-card">
          <h3>Procedural generation</h3>
          <ul>
            <li>Wave Function Collapse, implemented in the engine.</li>
          </ul>
        </div>

      </div>

      <figure class="tech-figure">
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube.com/embed/grZnYOMaqTQ?si=gf-zIuqm6VRQ5O4K"
            title="XEMA — Wave Function Collapse"
            allow="encrypted-media; picture-in-picture"
            loading="lazy"
            allowfullscreen></iframe>
        </div>
        <figcaption>Wave Function Collapse running in XEMA.</figcaption>
      </figure>
    </div>

    <!-- ── GRAPHICS ──────────────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2>Graphics</h2>
      <div class="tech-grid">

        <div class="tech-card">
          <h3>Rendering</h3>
          <ul>
            <li>Deferred rendering with PBR.</li>
            <li>Shadow mapping.</li>
            <li>Instanced rendering.</li>
          </ul>
        </div>

      </div>

      <figure class="tech-figure">
        <img
          src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-final.png`}
          alt="Final image of a XEMA frame: a procedurally generated landscape with trees and houses"
          width="590"
          height="186"
          loading="lazy"
        />
        <div class="gbuffer-grid">
          <div class="gbuffer-stack">
            <div class="gbuffer-item">
              <img src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-albedo.png`} alt="Albedo render target" width="365" height="115" loading="lazy" />
              <span class="gbuffer-label">Albedo</span>
            </div>
            <div class="gbuffer-item">
              <img src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-normal.png`} alt="Normals render target" width="664" height="210" loading="lazy" />
              <span class="gbuffer-label">Normals</span>
            </div>
            <div class="gbuffer-item">
              <img src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-position.png`} alt="Position render target" width="563" height="177" loading="lazy" />
              <span class="gbuffer-label">Position</span>
            </div>
          </div>
          <div class="gbuffer-item gbuffer-item--square">
            <img src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-shadow.png`} alt="Shadow map seen from the light" width="490" height="488" loading="lazy" />
            <span class="gbuffer-label">Shadow map</span>
          </div>
        </div>
        <figcaption>
          One XEMA frame captured in RenderDoc. The geometry pass writes albedo, normals and
          position to three render targets, and the lighting pass reads them together with the
          shadow map to draw the final image.
        </figcaption>
      </figure>

      <figure class="tech-figure tech-figure--natural">
        <img
          src={`${import.meta.env.BASE_URL}/project-images/xema/renderdoc-events.png`}
          alt="RenderDoc event list with several glDrawElementsInstanced calls followed by the depth-only and colour passes"
          width="623"
          height="252"
          loading="lazy"
        />
        <figcaption>
          Draw calls from the same frame: repeated meshes are drawn
          with <code>glDrawElementsInstanced</code>, up to 107 instances in a single call.
        </figcaption>
      </figure>
    </div>

    <!-- ── PLATFORMS ─────────────────────────────────────────────────────── -->
    <div class="tech-section">
      <h2>Platforms</h2>
      <div class="tech-grid">

        <div class="tech-card">
          <h3>Nintendo Switch — tested on emulator</h3>
          <ul>
            <li>Ported through <strong>libnx</strong> and <strong>EGL</strong>.</li>
            <li>I have only tested it on an emulator, not on a console.</li>
          </ul>
        </div>

        <div class="tech-card">
          <h3>PlayStation 4 — in progress</h3>
          <ul>
            <li>
              Running on a devkit: the ECS and rendering of simple geometry.
            </li>
            <li>
              Still missing: mesh loading, textures, instancing, lights, shadows and PBR.
            </li>
          </ul>
        </div>

      </div>
    </div>

  </div><!-- /.container -->

</Layout>
